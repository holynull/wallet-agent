# DeepSeek official OpenAI-compatible API. Keep secrets in .env (never commit it).
DEEPSEEK_API_KEY=
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com
ALLOWED_MODEL_IDS=["deepseek-chat","deepseek-reasoner"]
# Legacy-compatible alternative: OPENAI_API_KEY=

BRIDGERS_ENABLED=false
BRIDGERS_BASE_URL=https://api.bridgers.xyz
BRIDGERS_SOURCE_FLAG=
# Optional ERC-20 approval targets when Bridgers does not return a spender.
BRIDGERS_SPENDER_BY_CHAIN='{}'
BRIDGERS_SWAP_SPENDER=
OMNIBRIDGE_ENABLED=false
OMNIBRIDGE_BASE_URL=https://api.omnibridge.pro
OMNIBRIDGE_SOURCE_FLAG=
OMNIBRIDGE_SPENDER_BY_CHAIN='{}'
OMNIBRIDGE_SWAP_SPENDER=

PROVIDER_TIMEOUT_SECONDS=15
HTTP_TIMEOUT_SECONDS=15
ALLOWED_CHAINS='["EVM", "TRON", "SOLANA"]'
RPC_URLS='{"ETH":["https://cloudflare-eth.com","https://eth.llamarpc.com"],"BASE":["https://mainnet.base.org","https://base.llamarpc.com"],"ARBITRUM":["https://arb1.arbitrum.io/rpc","https://arbitrum.llamarpc.com"],"OPTIMISM":["https://mainnet.optimism.io","https://optimism.llamarpc.com"],"POLYGON":["https://polygon-rpc.com","https://polygon.llamarpc.com"],"BSC":["https://bsc-dataseed.binance.org","https://bsc-dataseed1.defibit.io"],"TRON":["https://api.trongrid.io"],"SOLANA":["https://api.mainnet-beta.solana.com","https://solana.drpc.org"]}'
RPC_TIMEOUT_SECONDS=10
RPC_MAX_ATTEMPTS=2
COINGECKO_API_KEY=
COINGECKO_BASE_URL=https://pro-api.coingecko.com/api/v3
# JSON maps: lowercase EVM token address -> CoinGecko id; native symbol -> id.
COINGECKO_TOKEN_IDS='{}'
COINGECKO_NATIVE_IDS='{"ETH":"ethereum"}'
PRICE_CACHE_TTL_SECONDS=60
PERSISTENCE_URL=sqlite+aiosqlite:///./wallet_agent.db
AUTH_REQUIRED=false
# JSON map of bearer token to user id; use an external verifier in production.
AUTH_TOKENS='{}'
POLL_INTERVAL_SECONDS=5
POLL_MAX_ATTEMPTS=20
CONFIRMATION_TTL_SECONDS=900
