# DeepSeek official OpenAI-compatible API. Keep secrets in .env (never commit it).
DEEPSEEK_API_KEY=
OPENAI_MODEL=deepseek-flash
INTENT_MODEL=deepseek-flash
SLOT_EXTRACTION_MODEL=deepseek-flash
RESPONSE_MODEL=deepseek-flash
READ_AGENT_ENABLED=true
READ_AGENT_MODEL=deepseek-flash
# Fast structured roles: no hidden reasoning; native read-only tools use low-effort thinking.
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_REASONING_EFFORT=none
READ_AGENT_THINKING_ENABLED=true
READ_AGENT_REASONING_EFFORT=low
OPENAI_BASE_URL=https://api.deepseek.com
ALLOWED_MODEL_IDS=["deepseek-flash","deepseek-v4-pro"]
# Legacy-compatible alternative: OPENAI_API_KEY=

# Safe local defaults. Replace only the secret values in .env.
BRIDGERS_ENABLED=true
BRIDGERS_BASE_URL=https://api.bridgers.xyz
BRIDGERS_SOURCE_FLAG=wallet-agent
BRIDGERS_SPENDER_BY_CHAIN='{}'
BRIDGERS_SWAP_SPENDER=
OMNIBRIDGE_ENABLED=true
OMNIBRIDGE_BASE_URL=https://api.omnibridge.pro
OMNIBRIDGE_SOURCE_FLAG=wallet-agent
OMNIBRIDGE_SPENDER_BY_CHAIN='{}'
OMNIBRIDGE_SWAP_SPENDER=

PROVIDER_TIMEOUT_SECONDS=15
HTTP_TIMEOUT_SECONDS=15
ALLOWED_CHAINS='["EVM", "BTC", "TRON", "SOLANA"]'
RPC_URLS='{"ETH":["https://ethereum-rpc.publicnode.com","https://eth.drpc.org","https://cloudflare-eth.com"],"BASE":["https://mainnet.base.org","https://base.llamarpc.com"],"ARBITRUM":["https://arb1.arbitrum.io/rpc","https://arbitrum.llamarpc.com"],"OPTIMISM":["https://mainnet.optimism.io","https://optimism.llamarpc.com"],"POLYGON":["https://polygon-rpc.com","https://polygon.llamarpc.com"],"BSC":["https://bsc-dataseed.binance.org","https://bsc-dataseed1.defibit.io"],"BTC":["https://blockstream.info"],"TRON":["https://api.trongrid.io"],"SOLANA":["https://api.mainnet-beta.solana.com","https://solana.drpc.org"]}'
RPC_TIMEOUT_SECONDS=10
RPC_MAX_ATTEMPTS=2
PERSISTENCE_URL=sqlite+aiosqlite:///./wallet_agent.db
# Multi-instance production example:
# PERSISTENCE_URL=mysql://wallet_agent:change-me@mysql:3306/wallet_agent
# PERSISTENCE_URL=postgresql+psycopg://wallet_agent:change-me@postgres:5432/wallet_agent
# REDIS_URL=redis://redis:6379/0
REDIS_URL=
REDIS_KEY_PREFIX=wallet-agent
RUN_EVENT_TTL_SECONDS=86400
RUN_EVENT_MAX_ENTRIES=2000
CONVERSATION_LOCK_LEASE_SECONDS=120
CONVERSATION_LOCK_WAIT_SECONDS=30
POLL_INTERVAL_SECONDS=5
POLL_MAX_ATTEMPTS=20

# Local demo defaults. Enable auth in deployments exposed beyond localhost.
AUTH_REQUIRED=false
AUTH_TOKENS='{}'
CONFIRMATION_TTL_SECONDS=900
# Comma-separated browser origins allowed to call the API. For a remote Demo,
# set this to its public URL, e.g. http://34.228.188.5:3000.
CORS_ALLOW_ORIGINS=

# OKX requires all four credentials below before it can be enabled.
OKX_ENABLED=false
OKX_BASE_URL=https://web3.okx.com
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_PROJECT_ID=
OKX_MAX_ATTEMPTS=3
OKX_CACHE_TTL_SECONDS=60
ASSET_CACHE_TTL_SECONDS=600
OKX_EXCLUDE_RISK_TOKENS=true
# Set OKX_INTEGRATION=1 only for opt-in read-only live checks.
OKX_INTEGRATION=0
OKX_INTEGRATION_ADDRESS=
OKX_INTEGRATION_TOKEN_ADDRESS=

# Host the graph on LangGraph Server: the platform owns persistence.
USE_PLATFORM_CHECKPOINTER=false
