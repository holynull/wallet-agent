# OpenAI is required to run the agent. Keep secrets in .env (never commit it).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

BRIDGERS_ENABLED=false
BRIDGERS_BASE_URL=
BRIDGERS_SOURCE_FLAG=
OMNIBRIDGE_ENABLED=false
OMNIBRIDGE_BASE_URL=
OMNIBRIDGE_SOURCE_FLAG=

PROVIDER_TIMEOUT_SECONDS=15
HTTP_TIMEOUT_SECONDS=15
ALLOWED_CHAINS='["EVM", "TRON", "SOLANA"]'
RPC_URLS='{}'
PERSISTENCE_URL=sqlite+aiosqlite:///./wallet_agent.db
POLL_INTERVAL_SECONDS=5
POLL_MAX_ATTEMPTS=20
